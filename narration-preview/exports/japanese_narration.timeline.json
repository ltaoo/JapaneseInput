  "sentences": [
    {
      "text": "昨日、学校へ行きました。",
      "start": 0.0,
      "end": 1.76,
      "char_start": 0,
      "char_end": 12
    },
    {
      "text": "学校の前に小さい猫がいました。",
      "start": 2.24,
      "end": 4.72,
      "char_start": 12,
      "char_end": 27
    },
    {
      "text": "猫はとてもかわいかったです。",
      "start": 5.12,
      "end": 7.04,
      "char_start": 27,
      "char_end": 41
    },
    {
      "text": "私は写真を撮りました。",
      "start": 7.52,
      "end": 9.44,
      "char_start": 41,
      "char_end": 52
    },
    {
      "text": "今日も学校へ行きました。",
      "start": 10.4,
      "end": 12.08,
      "char_start": 54,
      "char_end": 66
    },
    {
      "text": "でも、猫はいませんでした。",
      "start": 12.56,
      "end": 14.32,
      "char_start": 66,
      "char_end": 79
    },
    {
      "text": "少しさびしかったです。",
      "start": 14.56,
      "end": 16.0,
      "char_start": 79,
      "char_end": 90
    },
    {
      "text": "昼休みに友だちと話しました。",
      "start": 16.96,
      "end": 19.2,
      "char_start": 92,
      "char_end": 106
    },
    {
      "text": "友だちは「その猫は私の猫です」と言いました。",
      "start": 19.84,
      "end": 23.68,
      "char_start": 106,
      "char_end": 128
    }
  ]
}
