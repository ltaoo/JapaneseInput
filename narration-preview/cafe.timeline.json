  "sentences": [
    {
      "text": "きょう、友だちといっしょに喫茶店へ行きました。",
      "start": 0.0,
      "end": 2.88,
      "char_start": 0,
      "char_end": 23
    },
    {
      "text": "「コーヒーとケーキをください」と言うと、店員さんがにっこり笑いました。",
      "start": 3.84,
      "end": 8.88,
      "char_start": 24,
      "char_end": 59
    },
    {
      "text": "友だちはリュックからしゃしんを出しました。",
      "start": 9.84,
      "end": 12.4,
      "char_start": 61,
      "char_end": 82
    },
    {
      "text": "「この子はキャラメル。",
      "start": 13.36,
      "end": 14.72,
      "char_start": 83,
      "char_end": 94
    },
    {
      "text": "ボールで遊ぶのが大好きなんだよ！」",
      "start": 15.12,
      "end": 17.44,
      "char_start": 94,
      "char_end": 111
    },
    {
      "text": "帰り道、きっぷを買って、きゅうこう電車に乗りました。",
      "start": 18.4,
      "end": 22.0,
      "char_start": 113,
      "char_end": 139
    },
    {
      "text": "ちょっとつかれたけれど、とっても楽しい一日でした。",
      "start": 22.96,
      "end": 26.8,
      "char_start": 140,
      "char_end": 165
    }
  ]
}
